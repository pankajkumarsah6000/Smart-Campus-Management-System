# Copy to .env before running from the backend directory. Spring Boot loads it
# automatically. NEVER commit a real .env file or put the AI key in the frontend.

# --- Database ---
# Default (no setup needed) runs on an in-memory H2 database - good for local dev/demo.
# For Postgres:
#   DB_URL=jdbc:postgresql://localhost:5432/smartcampus
#   DB_USERNAME=postgres
#   DB_PASSWORD=yourpassword
#   DB_DRIVER=org.postgresql.Driver
#   JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
# For MySQL:
#   DB_URL=jdbc:mysql://localhost:3306/smartcampus
#   DB_USERNAME=root
#   DB_PASSWORD=yourpassword
#   DB_DRIVER=com.mysql.cj.jdbc.Driver
#   JPA_DIALECT=org.hibernate.dialect.MySQLDialect
DB_URL=jdbc:h2:mem:smartcampus;DB_CLOSE_DELAY=-1
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
DDL_AUTO=update
SHOW_SQL=false

# --- JWT ---
# Replace with a strong random secret before deployment.
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment
JWT_ACCESS_EXP=3600000
JWT_REFRESH_EXP=604800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://smart-campus-management-system-7ack.vercel.app,https://smart-campus-management-system-pw9z.vercel.app

# --- AI Assistant ---
# Backend-only key. NEVER expose this to the frontend.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-4-6

# --- Server ---
SERVER_PORT=8080
LOG_LEVEL=INFO
